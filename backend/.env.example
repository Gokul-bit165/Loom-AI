# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loom_ai
POSTGRES_USER=loom_ai
POSTGRES_PASSWORD=loom_ai_pass_2026

# Derived — kept here for explicit visibility.
# Override this to point to a different DB for tests.
DATABASE_URL=postgresql://loom_ai:loom_ai_pass_2026@localhost:5432/loom_ai

# ── LLM (Phase 3 — leave empty until narration layer is built) ────────────────
ANTHROPIC_API_KEY=

# ── App behaviour ─────────────────────────────────────────────────────────────
# Set to "development" in dev, "production" in prod.
APP_ENV=development

# Data source root — absolute or relative to backend/
DATA_DIR=../

# Paths to the four source CSVs (relative to DATA_DIR)
CSV_MACHINES=machines.csv
CSV_PRODUCTION=production_log.csv
CSV_BREAKDOWN=breakdown_events.csv
CSV_REVENUE=revenue_log.csv
